# এটা কপি করে `.env.local` নামে রাখুন (git-এ যাবে না)।
# Vercel-এ: Project → Settings → Environment Variables-এ একই নামে দিন (Production + Preview)।

# --- লোকাল ডেভ (প্রস্তাবিত): Next.js /backend → API-তে ফরওয়ার্ড করে, CORS লাগে না ---
NEXT_PUBLIC_API_BASE_URL=/backend
API_PROXY_TARGET=http://127.0.0.1:4100
# --- Vercel-এ: Render-এর URL সরাসরি দিন, API_PROXY_TARGET দেবেন না ---
# NEXT_PUBLIC_API_BASE_URL=https://chamberai-api.onrender.com

NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# Supabase → Settings → API Keys → Publishable key (sb_publishable_...) — ব্রাউজারে দেওয়া নিরাপদ; secret key কখনো নয়
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STORAGE_BUCKET=visit-media
